\dontrun{
set.seed(42)
mkFam = function(n, nSib) {
	d = data.frame(row.names = seq_len(n))
	for (s in seq_len(nSib)) {
		base = rnorm(n, 0, .3)
		for (w in 1:2) {
			d[[paste0("age", w, "_T", s)]] = base + (w - 1) * .5 + rnorm(n, 0, .05)
			d[[paste0("y", w, "_T", s)]] = 0
		}
	}
	d
}
m0 = umxLGCM(var = c("y1", "y2"), age = c("age1", "age2"), mzData = mkFam(50, 2), dzData = mkFam(50, 2), autoRun = FALSE)
